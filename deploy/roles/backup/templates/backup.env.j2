# Written by Ansible (deploy/roles/backup). Change the variables there, not this file.

STORAGE_TYPE={{ backup_storage }}

DB_ENGINE=sqlite
DATABASE_URL={{ database_path }}

LOCAL_DIR={{ backup_local_dir }}
LOCAL_PREFIX_DB=db

GCS_BUCKET={{ backup_gcs_bucket }}
GCS_CREDENTIALS={{ (app_root ~ '/shared/gcs-sa.json') if 'gcs' in backup_storage else '' }}
GCS_PREFIX_DB={{ app_name }}/db

RETENTION_DAYS={{ backup_retention_days }}
KEEP_LOCAL=0
